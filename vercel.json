{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/address", "destination": "/api" },
    { "source": "/charity", "destination": "/api" },
    { "source": "/donations", "destination": "/api" },
    { "source": "/donate", "destination": "/api" }
  ]
}
